{
  "manifest_version": 3,
  "name": "PDF Inspector",
  "version": "0.1.0",
  "description": "Inspect PDFs and convert them to Markdown locally.",
  "action": {
    "default_popup": "src/popup.html"
  },
  "permissions": [
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}

